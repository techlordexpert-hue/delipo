# ---- Shared database ----
# Added automatically when you connect an Upstash Redis database in Vercel > Storage.
# (KV_REST_API_URL and KV_REST_API_TOKEN, or UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN)

# ---- Paystack (server side only, never in the browser) ----
PAYSTACK_SECRET_KEY=

# ---- Administrator ----
# Starting admin login: username (default "yo!") and password. Change the password later in Admin > Settings.
ADMIN_USER=yo!
ADMIN_PASSWORD=
# Master key, also used by Bulk SMS. Long and private. It always works as an admin recovery key.
ADMIN_KEY=

# ---- SMS provider (copy from your SMS provider's API page) ----
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Delipo
# Optional: SMS_METHOD=POST_JSON | POST_FORM | GET, SMS_KEY_FIELD, SMS_SENDER_FIELD, SMS_TO_FIELD, SMS_MSG_FIELD, SMS_AUTH_HEADER
